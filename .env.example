# --- Postgres (von docker-compose gelesen) ---
POSTGRES_USER=juice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=juiceshop

# --- Server ---
NODE_ENV=development
PORT=3000
# Lokal: zeigt auf die Compose-Postgres. NIEMALS die Produktions-URL hier eintragen.
DATABASE_URL=postgresql://juice:change-me@localhost:5432/juiceshop

# Mindestens 16 Zeichen. Bei einem Wechsel werden alle Sessions ungültig.
SESSION_SECRET=bitte-durch-etwas-langes-ersetzen

# --- Discord ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Muss in der Discord-App als Redirect-URI hinterlegt sein — lokal UND in Produktion.
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback
# Ungültiges Token = der Server startet gar nicht.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Kommagetrennt. Vorher per GET /guilds/{id}/roles gegenprüfen — nicht raten.
ADMIN_ROLE_IDS=
