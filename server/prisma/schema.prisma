generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemKind {
  JUICE
  PRODUCE
  SEED
}

enum MovementType {
  ISSUE     // ausgebucht
  ADJUST    // Bestand absolut gesetzt
  CRAFT_IN  // durch Herstellung entstanden
  CRAFT_OUT // durch Herstellung verbraucht
}

model Item {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String
  kind      ItemKind
  imagePath String     @map("image_path")
  stock     Int        @default(0)
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  movements Movement[]

  @@index([kind, sortOrder])
  @@map("items")
}

/// Eine Tabelle für alle drei Bestandsarten: "wie viel ist rein- und rausgegangen"
/// ist bei Säften, Früchten und Samen dieselbe Frage. Ein Herstell-Durchlauf schreibt
/// Rohstoff- und Saftbewegungen unter einer gemeinsamen batchId.
model Movement {
  id            String       @id @default(uuid())
  itemId        String       @map("item_id")
  item          Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          MovementType
  delta         Int
  before        Int
  after         Int
  batchId       String?      @map("batch_id")
  createdBy     String       @map("created_by")
  createdByName String       @map("created_by_name")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@index([batchId])
  @@map("movements")
}
